# Copy to .env and adjust. docker-compose.yml reads .env.
# Port on this machine. Open the app at http://10.10.8.49:<APP_PORT>
APP_PORT=8080

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Host names / IPs people type in the browser, comma separated.
DJANGO_ALLOWED_HOSTS=10.10.8.49,localhost,127.0.0.1
# Full addresses including the port — logins and forms are rejected without this.
DJANGO_CSRF_TRUSTED_ORIGINS=http://10.10.8.49:8080,http://localhost:8080,http://127.0.0.1:8080

# Optional — only used by the old Terminal49 tracking code.
TERMINAL49_API_KEY=

# Address printed into shelf QR codes (blank = the address the print page was opened from).
QR_BASE_URL=https://ahliki-ims-bcb9gtdheae7f4ht.australiasoutheast-01.azurewebsites.net

# Email through Office 365 (Microsoft Graph OAuth). Leave blank to print emails to the log instead.
# See AZURE.md, "Email (Office 365)" for the app registration steps.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox that sends the emails (must be a real Office 365 mailbox, shared mailboxes work).
MS_GRAPH_SENDER=
DEFAULT_FROM_EMAIL=

# Daily container report email, sent at this time (Apia time, 24-hour). Blank turns it off.
CONTAINER_REPORT_TIME=07:00
# Who gets it, comma separated.
CONTAINER_REPORT_RECIPIENTS=
