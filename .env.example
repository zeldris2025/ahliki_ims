# Copy to .env and adjust. docker-compose.yml reads .env.
# Port on this machine. Open the app at http://10.10.8.49:<APP_PORT>
APP_PORT=8080

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Host names / IPs people type in the browser, comma separated.
DJANGO_ALLOWED_HOSTS=10.10.8.49,localhost,127.0.0.1
# Full addresses including the port — logins and forms are rejected without this.
DJANGO_CSRF_TRUSTED_ORIGINS=http://10.10.8.49:8080,http://localhost:8080,http://127.0.0.1:8080

# Optional — only used by the old Terminal49 tracking code.
TERMINAL49_API_KEY=
